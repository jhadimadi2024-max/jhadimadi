# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Kept strictly server-side; never exposed to client browser.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Supabase Configuration (Client-side, public-safe keys only)
# NOTE: Only publishable/anon keys are permitted. Never use service-role or secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Admin Authentication & Security (Server-side only)
# Never expose these variables to the frontend.
ADMIN_PASSCODE=
ADMIN_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Platform Payment Gateways (Optional public merchant numbers)
VITE_MERCHANT_BKASH=
VITE_MERCHANT_NAGAD=

